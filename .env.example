# Set only after the final public hostname is confirmed.
# SITE_URL=https://your-approved-domain.example
# Keep false until content is complete and publication is approved. ALLOW_INDEXING takes precedence.
ALLOW_INDEXING=false
# Legacy compatibility only; use ALLOW_INDEXING for new environments.
SITE_INDEXABLE=false

# Server-side Gemini configuration. Never expose this key to the browser or commit a real value.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
